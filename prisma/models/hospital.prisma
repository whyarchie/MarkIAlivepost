model Hospital {
    id                Int                @id @default(autoincrement())
    name              String
    helplineNumber    String             @unique
    contactNumber     String
    email             String
    address           String
    perDayPatientCost Int                @default(100)
    balance           Int                @default(0)
    order             Order[]
    userId            String             @unique
    password          String
    doctor            Doctor[]
    patientCondition  PatientCondition[]
    aiOverview        HospitalAiOverview?
    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
}

// Cached, AI-generated operational overview of a hospital's whole patient
// population. Regenerated once a day by a cron job (see src/utils/cron.ts) so the
// dashboard reads a stored briefing instead of making a live model call — one
// row per hospital, replaced in place on each run.
model HospitalAiOverview {
    id          Int      @id @default(autoincrement())
    hospitalId  Int      @unique
    hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
    // The full overview object returned by the generator:
    // { status, headline, keyInsights, concerns, recommendedActions, summaryMarkdown, stats }
    data        Json
    // When the overview was last (re)generated — surfaced to the dashboard.
    generatedAt DateTime @default(now())
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Doctor {
    id                Int                @id @default(autoincrement())
    name              String
    username          String             @unique
    hospitalId        Int
    hospital          Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
    patientConditions PatientCondition[]
    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
}
