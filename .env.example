# Chat attachment storage backend: s3 (default) or azure-blob
CHAT_STORAGE_PROVIDER=s3
CHAT_STORAGE_UPLOAD_URL_TTL_SECONDS=900
CHAT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=300

# S3 or an S3-compatible service (required when CHAT_STORAGE_PROVIDER=s3)
CHAT_S3_BUCKET=private-bucket
CHAT_S3_REGION=auto
CHAT_S3_ENDPOINT=
CHAT_S3_ACCESS_KEY_ID=
CHAT_S3_SECRET_ACCESS_KEY=
CHAT_S3_FORCE_PATH_STYLE=false

# Azure Blob with a managed identity or service principal (recommended)
# CHAT_STORAGE_PROVIDER=azure-blob
# CHAT_AZURE_STORAGE_AUTH_MODE=identity
# CHAT_AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
# CHAT_AZURE_STORAGE_CONTAINER=chat-attachments
# DefaultAzureCredential also accepts AZURE_TENANT_ID, AZURE_CLIENT_ID, and
# AZURE_CLIENT_SECRET when the app is not running with a managed identity.

# Azure Blob with a storage account key (requires allowSharedKeyAccess=true)
# CHAT_STORAGE_PROVIDER=azure-blob
# CHAT_AZURE_STORAGE_AUTH_MODE=shared-key
# CHAT_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# Or set CHAT_AZURE_STORAGE_ACCOUNT_NAME and CHAT_AZURE_STORAGE_ACCOUNT_KEY.
# CHAT_AZURE_STORAGE_CONTAINER=chat-attachments

# Optional for sovereign clouds/custom endpoints. HTTP must only be enabled for
# local Azurite development.
# CHAT_AZURE_STORAGE_ENDPOINT=https://yourstorageaccount.blob.core.windows.net
# AZURE_STORAGE_BLOB_ENDPOINT is accepted as a fallback.
# CHAT_AZURE_STORAGE_ALLOW_HTTP=false

CORS_ORIGINS=https://your-hospital-dashboard.example
